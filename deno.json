{
  "workspace": [
    "./packages/idobata-bot",
    "./web/client",
    "./web/server",
    "./web/tests"
  ],
  "tasks": {
    "dev": "deno task --cwd web/server dev",
    "serve": "deno task --cwd web/server serve",
    "build": "deno task --cwd web/server build",
    "build:cf": "deno task --cwd web/server build:cf",
    "cf": "deno run -A npm:cf",
    "deploy": "bash deploy.sh \"$(deno eval 'console.log(Deno.execPath())')\"",
    "deploy:preview": "deno task build:cf --preview && deno run -A npm:cf previews deploy --prebuilt",
    "db": "deno run -A jsr:@remix-kbn/data-table-d1/cli",
    "test": "deno test -P --ignore=web/tests",
    "test:browser": "deno task --cwd web/tests test",
    "check": "deno task --cwd web/client check && deno task --cwd web/server check && deno check packages && deno lint && deno fmt --check"
  },
  "permissions": {
    "default": {
      "read": true,
      "env": true,
      "net": [
        "id.kbn.one",
        "localhost",
        "127.0.0.1"
      ],
      "import": true
    }
  },
  "test": {
    "permissions": "default"
  },
  "nodeModulesDir": "auto",
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": [
      "jsr:@kuboon/*",
      "jsr:@remix-kbn/*",
      "npm:@remix-run/*"
    ]
  },
  "unstable": [
    "bundle"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@remix-run/component"
  },
  "imports": {
    "@cloudflare/build-output-utils": "npm:@cloudflare/build-output-utils@0.9.1",
    "@cloudflare/config": "npm:@cloudflare/config@0.25.0",
    "@kuboon/dpop": "jsr:@kuboon/dpop@^0.1.2",
    "@kuboon/md": "jsr:@kuboon/md@^0.9.0",
    "@kuboon/share-element": "jsr:@kuboon/share-element@^0.7.0",
    "@lightpanda/browser": "npm:@lightpanda/browser@^1.6.0",
    "@remix-kbn/assets-deno": "jsr:@remix-kbn/assets-deno@^0.9.0",
    "@remix-kbn/data-table-d1": "jsr:@remix-kbn/data-table-d1@^0.1.0",
    "@remix-kbn/helper-agent": "jsr:@remix-kbn/helper-agent@^0.4.0",
    "@remix-kbn/ssg": "jsr:@remix-kbn/ssg@^0.13.0",
    "@remix-run/component": "npm:@remix-run/component@^1.1.0",
    "@remix-run/cop-middleware": "npm:@remix-run/cop-middleware@^1.0.0",
    "@remix-run/data-table": "npm:@remix-run/data-table@^1.0.0",
    "@remix-run/fetch-router": "npm:@remix-run/fetch-router@^1.0.0",
    "@remix-run/render-middleware": "npm:@remix-run/render-middleware@^1.0.1",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "canvaskit-wasm": "npm:canvaskit-wasm@^0.40.0",
    "cf": "npm:cf@1.0.0-beta.16",
    "hast": "npm:@types/hast@^3.0.5",
    "jose": "jsr:@panva/jose@^6.2.3",
    "mdast": "npm:@types/mdast@^4.0.4",
    "puppeteer-core": "npm:puppeteer-core@^23.11.1",
    "character-entities": "npm:character-entities@^2.0.2",
    "remark-gfm": "npm:remark-gfm@^4.0.1",
    "remark-parse": "npm:remark-parse@^11.0.0",
    "unified": "npm:unified@^11.0.5"
  },
  "fmt": {
    "exclude": [
      "web/dist",
      "web/worker-dist",
      ".cloudflare",
      "node_modules"
    ]
  },
  "lint": {
    "exclude": [
      "web/dist",
      "web/worker-dist",
      ".cloudflare",
      "node_modules"
    ]
  }
}
